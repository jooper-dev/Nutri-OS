# ==========================================
# REGLAS DE SEGURIDAD MÉDICA (INQUEBRANTABLES)
# ==========================================
# Ignorar estrictamente todo el contenido de los pacientes (PDFs, historiales, JSONs generados)
pacientes/*

# EXCEPCIÓN: Forzar a Git a conservar la estructura de la carpeta para cuando se clone
!pacientes/.gitkeep

# ==========================================
# SEGURIDAD DE SESIÓN LOCAL (OAUTH TOKENS)
# ==========================================
# Ignorar los tokens de sesión generados por GWS CLI en la máquina local
token.json
*token*.json
.gws*

# ==========================================
# ARCHIVOS DE SISTEMA LOCALES
# ==========================================
.DS_Store
Thumbs.db
