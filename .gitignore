# ==========================================================================
# DATOS CLÍNICOS — nunca se suben. Son historiales de menores.
# ==========================================================================
pacientes/*
!pacientes/.gitkeep
!pacientes/_EJEMPLO_Mateo/
salidas/*
!salidas/.gitkeep

# ==========================================================================
# SECRETOS
# Estas dos líneas faltaban en el repositorio anterior y por eso se filtraron
# las credenciales de Google al hacerlo público. No las quites.
# ==========================================================================
.env
.env.*
credentials.json
client_secret*.json
token.json
*token*.json
.gws*
*.pem
*.key

# Nota: biblioteca/imagenes/ y biblioteca/prompts_imagen/ SÍ se versionan.
# Regenerar una imagen cuesta dinero y la receta ya no cambia: son activos.

# ==========================================================================
# ENTORNO
# ==========================================================================
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
Thumbs.db
